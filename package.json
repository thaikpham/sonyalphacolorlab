{
  "name": "alpha-colorlab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed:emit": "tsx scripts/emit-seed.ts",
    "doctor": "tsx scripts/doctor.ts",
    "tokens:emit": "tsx packages/colorlab-tokens/src/emit.ts",
    "fonts:vendor": "node scripts/vendor-fonts.mjs",
    "design:baseline": "tsx scripts/design-baseline.ts",
    "//": "The gate. This is what CI runs and what a developer runs before assuming a change is safe. It chained two more `-w apps/*` gates while CheeseBooth and Sony Live SOP were workspaces here; they are their own repos now and gate themselves.",
    "//build": "`build` is last and is not optional. Lint, typecheck and the suite all passed against a tree whose stylesheet imported a deleted file — none of the three resolves a CSS import, so the app failed to compile with the whole gate green. It is the slowest step, so it runs after the fast ones have had their chance to fail.",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "push:supabase": "tsx --env-file=.env.local scripts/push-supabase.ts",
    "pull:supabase": "tsx --env-file=.env.local scripts/pull-supabase.ts",
    "migrate:images": "tsx --env-file=.env.local scripts/migrate-images.ts",
    "reddit:token": "tsx --env-file=.env.local scripts/reddit-token.ts",
    "reddit:seed": "tsx --conditions=react-server --env-file=.env.local scripts/reddit-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.110.9",
    "next": "^16.3.0",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
