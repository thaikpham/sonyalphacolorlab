# Supabase — two projects, two trust boundaries.
#
# The CONTROL plane owns Auth, admin_emails and community data. The CONTENT
# plane owns recipes, the Sony catalogue and the article corpus. They live in
# separate organisations so a content egress incident cannot take sign-in down
# with it, which is exactly what happened on 2026-09-11.
#
# All six are set, or all six are absent. A half-configured boundary is a
# deployment error, not a degraded mode — see scripts/check-supabase-env.ts.
# Absent everywhere is the seed-backed offline mode the test suite runs in.

# Control plane. The browser holds the anon key and nothing else.
NEXT_PUBLIC_AUTH_SUPABASE_URL=
NEXT_PUBLIC_AUTH_SUPABASE_ANON_KEY=
# Server-only. Verifies bearer tokens, reads admin_emails, writes community
# tables. Never prefix this NEXT_PUBLIC_.
AUTH_SUPABASE_SECRET_KEY=

# Content plane. The URL is public because public Storage URLs expose the host
# anyway; neither key below is.
NEXT_PUBLIC_CONTENT_SUPABASE_URL=
CONTENT_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Only reachable after requireAdmin() has passed
# against the CONTROL plane. Never prefix this NEXT_PUBLIC_.
CONTENT_SUPABASE_SECRET_KEY=

# Optional, server-only, both off by default.
#
# CONTENT_ADMIN_FROZEN rejects product/article/upload mutations before the body
# is parsed, leaving Auth, community and every public read available. It is how
# the final cutover delta is taken without losing a write.
#
# SUPABASE_ROLLBACK_MODE is the ONLY way the two URLs may name one project. It
# exists for the documented emergency rollback to the retained old content
# tables and must be unset again afterwards.
# CONTENT_ADMIN_FROZEN=true
# SUPABASE_ROLLBACK_MODE=true

# Server-only. Powers /api/tweak.
ANTHROPIC_API_KEY=

# Absolute site URL, used for canonical links, OG tags and share URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AI_DAILY_CALL_CAP=500
